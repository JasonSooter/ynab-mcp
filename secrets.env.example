# Copy to secrets.env (gitignored) and fill in. Every value here is a secret.
# The server REFUSES TO START unless all three are set: the login page is the
# only thing between the public internet and a token that can edit the budget.

# YNAB personal access token (YNAB -> Account Settings -> Developer Settings).
# It has full read/write access to every budget on the account.
YNAB_API_KEY=

# Login password, minimum 12 characters.
YNAB_MCP_LOGIN_PASSWORD=

# Base32, as an authenticator shows it -- copy the 'setup key' / secret, NOT
# the 6-digit code.
YNAB_MCP_TOTP_SECRET=
